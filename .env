# Local defaults for the published OSWatcher stack.
# This file is intentionally committed so `docker compose up -d` works after cloning.
# These credentials are for localhost evaluation, not an internet-facing deployment.

COMPOSE_PROJECT_NAME=oswatcher
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yml:compose.prod.yml
DOMAIN=localhost
HTTP_SCHEME=http
BIND_ADDRESS=127.0.0.1

NEO4J_VERSION=5.26
NEO4J_AUTH=none
NEO4J_USER=neo4j
NEO4J_PASSWORD=""
NEO4J_HEAP_INITIAL_SIZE=512m
NEO4J_HEAP_MAX_SIZE=1g
NEO4J_PAGECACHE_SIZE=512m

# Ready-to-use corpus. On the first `up -d`, download a Neo4j dump from
# SEED_DB_URL and load it before Neo4j starts. Bump SEED_DB_VERSION to pull a
# refreshed dump. Set SEED_DB=false (or leave SEED_DB_URL empty) to start with an
# empty graph and build your own corpus with osw-builder.
SEED_DB=true
SEED_DB_URL=https://pub-0643f5dd957a4dd59d11611c12306685.r2.dev/neo4j-public-2026-09-08.dump
SEED_DB_VERSION=2026-09-09

MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=oswatcher-local
MINIO_ACCESS_KEY=api-blob-download
MINIO_SECRET_KEY=oswatcher-local-api

TRAEFIK_VERSION=3.6.2
